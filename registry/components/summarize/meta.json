{
  "name": "summarize",
  "title": "Summarize",
  "description": "The gist of long text: card, inline, sheet or tooltip. Streams, and map-reduces input that does not fit the on-device context.",
  "category": "text",
  "priority": "P0",
  "capabilities": ["text"],
  "variants": {
    "variant": ["clean", "minimal", "glass", "pop", "candy", "metal", "shine", "bevel"],
    "presentation": ["card", "inline", "sheet", "tooltip"],
    "size": ["sm", "md", "lg"],
    "length": ["oneLine", "bullets", "paragraph"],
    "emphasis": ["plain", "quote", "highlighted"]
  },
  "registryDependencies": [
    "button",
    "model-download",
    "on-device-badge",
    "sheet",
    "shimmer-text",
    "skeleton",
    "streaming-text",
    "surface"
  ],
  "files": ["summarize.tsx", "use-summarize.ts", "prompts.ts", "index.ts"],
  "budget": {
    "input": 3400,
    "strategy": "Single streamed pass when the text fits; otherwise map (bullets per chunk) then reduce (streamed)."
  },
  "runsOn": ["apple", "nano", "cloud"]
}
