{
  "name": "smart-input",
  "title": "SmartInput",
  "description": "Text, voice or photo fills your zod form on device, with per-field confidence, deterministic refinement and confirm/undo.",
  "category": "input",
  "priority": "P0",
  "capabilities": ["structured"],
  "variants": {
    "variant": ["clean", "minimal", "glass", "pop", "candy", "metal", "shine", "bevel"],
    "presentation": ["field", "composer", "overlay", "card"],
    "size": ["sm", "md", "lg"],
    "confidenceStyle": ["highlight", "badge", "underline"]
  },
  "registryDependencies": [
    "button",
    "chip",
    "ion-border",
    "on-device-badge",
    "shimmer-text",
    "skeleton",
    "surface"
  ],
  "files": ["smart-input.tsx", "use-smart-form.ts", "prompts.ts", "index.ts"],
  "budget": {
    "input": 1500,
    "strategy": "One structured call; enum/number/date fields are refined deterministically after parsing."
  },
  "runsOn": ["apple", "nano", "cloud"]
}
