{
  "name": "@ondai/web-shims",
  "version": "0.1.0",
  "private": true,
  "description": "Browser implementations of the native modules Ondai components may import, for react-native-web under Next.js.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./react-native-svg": "./src/react-native-svg.ts",
    "./expo-haptics": "./src/expo-haptics.ts",
    "./expo-blur": "./src/expo-blur.tsx",
    "./expo-clipboard": "./src/expo-clipboard.ts",
    "./expo-image-picker": "./src/expo-image-picker.ts"
  },
  "scripts": { "typecheck": "tsc --noEmit", "lint": "eslint src" },
  "dependencies": { "react-native-svg": "catalog:" },
  "peerDependencies": { "react": ">=19", "react-native-web": ">=0.21" },
  "devDependencies": {
    "@ondai/config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "catalog:",
    "typescript": "catalog:"
  }
}
